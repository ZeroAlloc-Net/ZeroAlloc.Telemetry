<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>ZeroAlloc.Telemetry</PackageId>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Source-generated OpenTelemetry instrumentation — Activity spans and Meter instruments without reflection or params object[] allocation. AOT-safe.</Description>
    <Version>0.0.0-local</Version>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroAlloc.Telemetry.Generator\ZeroAlloc.Telemetry.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!--
    Bundle the generator DLL the build actually produced. Asking the generator project for its
    target path, instead of hardcoding bin\$(Configuration)\netstandard2.0, follows any output
    redirection such as artifacts-path. The hardcoded path silently bundled whatever stale DLL
    sat in the repository's bin folder, at whatever version that DLL had been built with.
    See ZeroAlloc-Net/.github#43.
  -->
  <Target Name="IncludeGeneratorInPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\ZeroAlloc.Telemetry.Generator\ZeroAlloc.Telemetry.Generator.csproj"
             Targets="GetTargetPath"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_ZeroAllocTelemetryGeneratorAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_ZeroAllocTelemetryGeneratorAssembly)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>
  </Target>
</Project>
